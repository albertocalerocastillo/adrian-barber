# Copia este archivo a .env y rellena con tus valores de Supabase
# (Supabase -> Project Settings -> API). Se usará a partir de la Fase 2.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# Aviso de cita nueva por WhatsApp (CallMeBot):
# YA NO VA AQUÍ. Cualquier variable VITE_* acaba incrustada en el JS público,
# así que la apikey quedaba a la vista. Ahora vive como secreto del servidor,
# en la Edge Function supabase/functions/aviso-cita:
#
#   supabase secrets set CALLMEBOT_PHONE=34XXXXXXXXX CALLMEBOT_APIKEY=tu-apikey
#   supabase functions deploy aviso-cita
#
# Si tenías VITE_CALLMEBOT_PHONE / VITE_CALLMEBOT_APIKEY en Vercel, BÓRRALAS.
